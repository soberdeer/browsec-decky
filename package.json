{
  "name": "browsec-decky",
  "version": "0.1.2",
  "packageManager": "pnpm@9.15.9",
  "description": "Independent Browsec VPN controller for Steam Deck Game Mode",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build",
    "package": "bash scripts/package.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soberdeer/browsec-decky.git"
  },
  "keywords": [
    "browsec",
    "decky",
    "steam-deck",
    "steamos",
    "vpn"
  ],
  "author": "soberdeer",
  "license": "LicenseRef-Browsec-Decky-Freeware-1.0",
  "bugs": {
    "url": "https://github.com/soberdeer/browsec-decky/issues"
  },
  "homepage": "https://github.com/soberdeer/browsec-decky#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "tslib": "^2.7.0"
  }
}
